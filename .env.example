# MCP Portico environment variables
MCP_PORTICO_HOST=127.0.0.1
MCP_PORTICO_PORT=3000
MCP_PORTICO_AUTH_MODE=none
# Required for bearer auth and key creation. Keep the real value in a secret manager.
MCP_PORTICO_KEY_PEPPER=
FINANCE_MOCK_API_KEY=finance-demo-key
SUPPORT_MOCK_TOKEN=support-demo-token
# Optional override for the config home directory.
MCP_PORTICO_CONFIG_HOME=
